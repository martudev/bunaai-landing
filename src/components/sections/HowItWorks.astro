---
import { STEPS } from "../../data/content";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
---

<Section id="como-funciona">
  <SectionHeading
    eyebrow="Cómo funciona"
    title="De una frase a una automatización corriendo"
    subtitle="Cuatro pasos, y los cuatro pasan dentro del panel. No hay nada que instalar ni que configurar por afuera."
  />

  <ol class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
    {
      STEPS.map((step, index) => (
        <li class="relative rounded-2xl border border-ink-900/10 bg-card p-6">
          <span
            class="flex size-9 items-center justify-center rounded-xl bg-brand-500 font-display text-base font-bold text-white"
            aria-hidden="true"
          >
            {index + 1}
          </span>
          <h3 class="mt-5 font-sans text-lg font-semibold text-ink-900">
            {step.title}
          </h3>
          <p class="mt-2.5 text-[0.95rem] leading-relaxed text-ink-700">
            {step.body}
          </p>
        </li>
      ))
    }
  </ol>
</Section>
