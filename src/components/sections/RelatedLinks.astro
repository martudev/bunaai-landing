---
import { SOLUTIONS } from "../../data/solutions";
import Section from "../ui/Section.astro";
import Icon from "../ui/Icon.astro";

/**
 * Enlazado interno entre páginas de keyword.
 *
 * No es decoración: es lo que arma el cluster temático. Google usa los links
 * entre páginas del mismo tema para entender que el sitio tiene autoridad
 * sobre él, y le da a cada página el contexto de las otras.
 */
interface Props {
  slugs: string[];
  title?: string;
}

const { slugs, title = "Seguí leyendo" } = Astro.props;

const items = slugs
  .map((slug) => SOLUTIONS.find((solution) => solution.slug === slug))
  .filter((solution): solution is (typeof SOLUTIONS)[number] => Boolean(solution));
---

{
  items.length > 0 && (
    <Section tone="muted">
      <h2 class="text-2xl md:text-3xl">{title}</h2>

      <ul class="mt-8 grid gap-4 md:grid-cols-3">
        {items.map((item) => (
          <li>
            <a
              href={`/${item.slug}`}
              class="group flex h-full flex-col rounded-2xl border border-ink-900/10 bg-card p-6 transition-colors duration-200 hover:border-brand-300"
            >
              <p class="text-xs font-semibold tracking-wide text-brand-600 uppercase">
                {item.eyebrow}
              </p>
              <h3 class="mt-3 font-sans text-[1.05rem] leading-snug font-semibold text-ink-900">
                {item.h1}
              </h3>
              <span class="mt-4 inline-flex items-center gap-1.5 text-[0.9rem] font-semibold text-brand-600">
                Ver más
                <span class="transition-transform duration-200 group-hover:translate-x-0.5">
                  <Icon name="arrow-right" size={14} />
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </Section>
  )
}
