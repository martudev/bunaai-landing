---
import { FINAL_CTA } from "../../data/content";
import { CTA } from "../../data/site";
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";

interface Props {
  title?: string;
  subtitle?: string;
}

const { title = FINAL_CTA.title, subtitle = FINAL_CTA.subtitle } = Astro.props;
---

<section class="bg-white py-20 md:py-24">
  <div class="container-page">
    <div
      class="relative overflow-hidden rounded-3xl bg-ink-900 px-7 py-16 text-center md:px-16"
    >
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(40rem_22rem_at_50%_-20%,rgba(47,172,106,0.35),transparent_70%)]"
      >
      </div>

      <div class="relative mx-auto max-w-2xl">
        <h2 class="text-3xl text-white md:text-4xl">{title}</h2>
        <p class="mt-5 text-lg leading-relaxed text-white/70">{subtitle}</p>

        <div class="mt-9 flex flex-wrap justify-center gap-3">
          <Button href={CTA.primary.href} size="lg">
            {CTA.primary.label}
            <Icon name="arrow-right" size={18} />
          </Button>
          <Button
            href={CTA.secondary.href}
            variant="secondary"
            size="lg"
            class="border-white/20 bg-white/10 text-white hover:border-white/35 hover:bg-white/15"
          >
            {CTA.secondary.label}
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>
