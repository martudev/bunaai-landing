---
import { USE_CASES } from "../../data/content";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Icon from "../ui/Icon.astro";
---

<Section id="casos" tone="muted">
  <SectionHeading
    eyebrow="Qué le podés pedir"
    title="Ejemplos reales, escritos tal cual se los pedirías"
    subtitle="No son plantillas para elegir de una lista. Son frases que podés escribirle hoy y que se convierten en una automatización corriendo."
  />

  <ul class="mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
    {
      USE_CASES.map((useCase) => (
        <li class="flex flex-col rounded-2xl border border-ink-900/10 bg-card p-5 transition-shadow duration-200 hover:shadow-[0_1px_2px_rgba(5,10,52,0.04),0_16px_36px_-22px_rgba(5,10,52,0.3)]">
          <p class="text-xs font-semibold tracking-wide text-brand-600 uppercase">
            {useCase.tag}
          </p>
          <blockquote class="mt-3 flex-1 text-[0.93rem] leading-relaxed text-ink-900">
            <span class="text-ink-500">“</span>{useCase.prompt}
            <span class="text-ink-500">”</span>
          </blockquote>
          <p class="mt-4 flex items-start gap-2 border-t border-ink-900/8 pt-3.5 text-[0.85rem] font-medium text-ink-700">
            <span class="mt-0.5 text-brand-500">
              <Icon name="arrow-right" size={14} />
            </span>
            {useCase.result}
          </p>
        </li>
      ))
    }
  </ul>
</Section>
