---
import { CONTRAST } from "../../data/content";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Icon from "../ui/Icon.astro";
---

<Section tone="muted">
  <SectionHeading title={CONTRAST.title} subtitle={CONTRAST.subtitle} />

  <div class="mx-auto mt-14 grid max-w-5xl gap-5 md:grid-cols-2">
    <div class="rounded-2xl border border-ink-900/10 bg-white/60 p-7">
      <h3 class="font-sans text-sm font-semibold tracking-wide text-ink-500 uppercase">
        {CONTRAST.before.label}
      </h3>
      <ul class="mt-5 space-y-4">
        {
          CONTRAST.before.items.map((item) => (
            <li class="flex items-start gap-3 text-[0.97rem] leading-relaxed text-ink-700">
              <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-ink-900/8 text-ink-500">
                <Icon name="x" size={12} />
              </span>
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <div
      class="rounded-2xl border border-brand-200 bg-white p-7 shadow-[0_1px_2px_rgba(5,10,52,0.04),0_18px_44px_-24px_rgba(47,172,106,0.45)]"
    >
      <h3 class="font-sans text-sm font-semibold tracking-wide text-brand-700 uppercase">
        {CONTRAST.after.label}
      </h3>
      <ul class="mt-5 space-y-4">
        {
          CONTRAST.after.items.map((item) => (
            <li class="flex items-start gap-3 text-[0.97rem] leading-relaxed text-ink-900">
              <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-brand-500 text-white">
                <Icon name="check" size={12} />
              </span>
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Section>
