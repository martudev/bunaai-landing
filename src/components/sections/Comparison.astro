---
import { COMPARISON } from "../../data/content";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";

// La primera columna es Buna: se resalta con fondo propio para que la tabla se
// lea de un vistazo sin tener que cruzar la fila entera.
---

<Section tone="muted">
  <SectionHeading
    eyebrow="Comparativa"
    title="Dónde está la diferencia, en concreto"
    subtitle="No se trata de tener IA: casi todas la tienen. Se trata de quién decide qué podés cambiar."
  />

  {/*
    `overflow-x-auto` con `tabindex` para que el scroll horizontal de la tabla
    en mobile también sea alcanzable con teclado.
  */}
  <div
    class="mt-14 overflow-x-auto rounded-2xl border border-ink-900/10 bg-white"
    tabindex="0"
    role="region"
    aria-label="Comparación entre Buna y otras herramientas"
  >
    <table class="w-full min-w-[46rem] border-collapse text-left">
      <thead>
        <tr class="border-b border-ink-900/10">
          <th scope="col" class="p-5 text-sm font-semibold text-ink-500">
            <span class="sr-only">Característica</span>
          </th>
          {
            COMPARISON.columns.map((column, index) => (
              <th
                scope="col"
                class:list={[
                  "p-5 font-sans text-[0.95rem] font-bold",
                  index === 0
                    ? "bg-brand-50 text-brand-700"
                    : "text-ink-700",
                ]}
              >
                {column}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          COMPARISON.rows.map((row) => (
            <tr class="border-b border-ink-900/8 last:border-0">
              <th
                scope="row"
                class="p-5 align-top font-sans text-[0.92rem] font-semibold text-ink-900"
              >
                {row.feature}
              </th>
              {row.values.map((value, index) => (
                <td
                  class:list={[
                    "p-5 align-top text-[0.92rem]",
                    index === 0
                      ? "bg-brand-50/60 font-medium text-brand-800"
                      : "text-ink-700",
                  ]}
                >
                  {value}
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</Section>
