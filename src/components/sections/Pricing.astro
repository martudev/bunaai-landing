---
import { PLANS, formatPrice, planCta, annualMonthly, annualTotal } from "../../data/pricing";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";

interface Props {
  tone?: "default" | "muted";
  title?: string;
  subtitle?: string;
  /** En la home se muestra el bloque compacto y se linkea a /precios. */
  compact?: boolean;
  /**
   * Nivel del heading de cada plan. En la home la sección tiene su propio h2
   * ("Precios") y los planes cuelgan de él como h3; en /precios no hay h2
   * intermedio, así que los planes son h2 y no se saltea un nivel.
   */
  cardAs?: "h2" | "h3";
}

const {
  tone = "default",
  title = "Precios",
  subtitle = "La infraestructura, el historial de cambios y las integraciones están incluidos. No hay costo de setup ni permanencia. Precios en pesos, pagás con Mercado Pago.",
  compact = false,
  cardAs: CardHeading = "h3",
} = Astro.props;
---

<Section id="precios" tone={tone}>
  <SectionHeading title={title} subtitle={subtitle} />

  {/*
    Mensual / anual: los dos precios se renderizan y el toggle solo cambia
    `data-billing` del contenedor; las clases group-data-* muestran uno u
    otro. Sin JS queda el mensual, que es el default.
  */}
  <div data-billing-root data-billing="monthly" class="group">
  <div class="mt-10 flex justify-center">
    <div
      role="radiogroup"
      aria-label="Frecuencia de pago"
      class="inline-flex rounded-full border border-ink-900/10 bg-card p-1 text-[0.92rem] font-semibold"
    >
      <button
        type="button"
        role="radio"
        data-billing-option="monthly"
        aria-checked="true"
        class="rounded-full px-4 py-2 text-ink-700 transition-colors group-data-[billing=monthly]:bg-brand-500 group-data-[billing=monthly]:text-white"
      >
        Mensual
      </button>
      <button
        type="button"
        role="radio"
        data-billing-option="annual"
        aria-checked="false"
        class="flex items-center gap-2 rounded-full px-4 py-2 text-ink-700 transition-colors group-data-[billing=annual]:bg-brand-500 group-data-[billing=annual]:text-white"
      >
        Anual
        <span class="rounded-full bg-brand-100 px-2 py-0.5 text-xs text-brand-700">
          2 meses gratis
        </span>
      </button>
    </div>
  </div>

  {/*
    Tres columnas recién en lg: por debajo de 1024px las tarjetas quedan
    demasiado angostas para las listas de features, así que van una abajo de
    la otra.
  */}
  <div class="mx-auto mt-12 grid max-w-6xl gap-5 lg:grid-cols-3">
    {
      PLANS.map((plan) => (
        <div
          class:list={[
            "relative flex flex-col rounded-2xl border p-7",
            plan.featured
              ? "border-brand-300 bg-card shadow-[0_1px_2px_rgba(5,10,52,0.04),0_24px_56px_-28px_rgba(47,172,106,0.5)] lg:-my-3 lg:py-10"
              : "border-ink-900/10 bg-card",
          ]}
        >
          {plan.featured && (
            <span class="absolute -top-3 left-7 rounded-full bg-brand-500 px-3 py-1 text-xs font-semibold text-white">
              El más elegido
            </span>
          )}

          <CardHeading class="font-sans text-lg font-bold text-ink-900">
            {plan.name}
          </CardHeading>
          <p class="mt-1 text-[0.9rem] text-ink-500">{plan.tagline}</p>

          <p class="mt-6 flex items-baseline gap-1.5">
            {plan.priceFrom && <span class="text-[0.95rem] text-ink-500">Desde</span>}
            <span class="font-display text-4xl font-bold text-ink-900">
              {plan.priceFrom ? (
                formatPrice(plan.price)
              ) : (
                <>
                  <span class="group-data-[billing=annual]:hidden">{formatPrice(plan.price)}</span>
                  <span class="hidden group-data-[billing=annual]:inline">
                    {formatPrice(annualMonthly(plan.price))}
                  </span>
                </>
              )}
            </span>
            <span class="text-[0.95rem] text-ink-500">/mes</span>
          </p>
          {/* Reserva la línea también en mensual para que las tarjetas no salten al cambiar. */}
          <p class="mt-1 min-h-[1.4em] text-[0.85rem] text-ink-500">
            <span class="hidden group-data-[billing=annual]:inline">
              {plan.priceFrom
                ? "Precio anual a convenir"
                : `${formatPrice(annualTotal(plan.price))} facturados una vez al año`}
            </span>
          </p>

          <p class="mt-4 text-[0.92rem] leading-relaxed text-ink-700">
            {plan.description}
          </p>

          <ul class="mt-6 flex-1 space-y-3 border-t border-ink-900/8 pt-6">
            {plan.features.map((feature) => (
              <li class="flex items-start gap-2.5 text-[0.92rem] text-ink-700">
                <span class="mt-0.5 flex size-4.5 shrink-0 items-center justify-center rounded-full bg-brand-100 text-brand-700">
                  <Icon name="check" size={11} />
                </span>
                {feature}
              </li>
            ))}
          </ul>

          <Button
            href={planCta(plan).href}
            variant={plan.featured ? "primary" : "secondary"}
            size="lg"
            class="mt-7 w-full"
          >
            {planCta(plan).label}
          </Button>
        </div>
      ))
    }
  </div>
  </div>

  {
    compact && (
      <p class="mt-10 text-center text-[0.95rem] text-ink-700">
        <a
          href="/precios"
          class="font-semibold text-brand-600 hover:text-brand-700 hover:underline"
        >
          Compará los planes en detalle
        </a>
      </p>
    )
  }
</Section>

<script>
  document.querySelectorAll<HTMLElement>("[data-billing-root]").forEach((root) => {
    const options = root.querySelectorAll<HTMLButtonElement>("[data-billing-option]");
    options.forEach((option) => {
      option.addEventListener("click", () => {
        root.dataset.billing = option.dataset.billingOption;
        options.forEach((o) => o.setAttribute("aria-checked", String(o === option)));
      });
    });
  });
</script>
