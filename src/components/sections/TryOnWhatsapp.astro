---
/**
 * Sección "Probalo en nuestro WhatsApp": prueba social en vez de promesa.
 * Nuestro propio número lo atiende un agente de BunaAI, así que el CTA es
 * hablarle. A la derecha, una charla de ejemplo que se arma sola al entrar en
 * pantalla (misma secuencia `.seq` que la demo del hero).
 */
import { TRY_WHATSAPP } from "../../data/content";
import { whatsappLink } from "../../data/site";
import Section from "../ui/Section.astro";
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import BrandLogo from "../ui/BrandLogo.astro";

const href = whatsappLink(TRY_WHATSAPP.message);
---

<Section id="probalo">
  <div
    data-reveal
    class="grid items-center gap-12 overflow-hidden rounded-3xl border border-ink-900/10 bg-surface-muted p-7 md:p-12 lg:grid-cols-[1.1fr_1fr] lg:gap-16"
  >
    <div>
      <p class="mb-3 text-sm font-semibold tracking-wide text-brand-600 uppercase">
        {TRY_WHATSAPP.eyebrow}
      </p>
      <h2 class="text-3xl text-ink-900 md:text-4xl">{TRY_WHATSAPP.title}</h2>
      <p class="mt-5 text-lg leading-relaxed text-ink-700">
        {TRY_WHATSAPP.subtitle}
      </p>

      <ul class="mt-7 grid gap-3">
        {
          TRY_WHATSAPP.ideas.map((idea) => (
            <li class="flex items-start gap-3 text-[0.98rem] text-ink-700">
              <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-brand-100 text-brand-700">
                <Icon name="check" size={13} />
              </span>
              {idea}
            </li>
          ))
        }
      </ul>

      <div class="mt-9">
        <Button href={href} size="lg">
          {TRY_WHATSAPP.cta}
          <Icon name="arrow-right" size={18} />
        </Button>
      </div>
    </div>

    {/* Charla de ejemplo, decorativa: el texto real de la sección está a la izquierda. */}
    <div aria-hidden="true" data-seq class="mx-auto w-full max-w-sm">
      <div
        class="overflow-hidden rounded-2xl border border-ink-900/10 bg-card shadow-[0_1px_2px_rgba(5,10,52,0.04),0_24px_60px_-24px_rgba(5,10,52,0.22)]"
      >
        <div class="flex items-center gap-3 border-b border-ink-900/8 px-4 py-3">
          {/* El favicon ya es un cuadrado verde redondeado: va solo como avatar, sin fondo. */}
          <img src="/favicon.svg" alt="" width="36" height="36" class="size-9 shrink-0" loading="lazy" decoding="async" />
          <div class="leading-tight">
            <p class="text-sm font-semibold text-ink-900">BunaAI</p>
            <p class="flex items-center gap-1.5 text-xs text-brand-600">
              <span class="live-dot size-1.5 rounded-full bg-brand-500"></span>
              en línea
            </p>
          </div>
          <span class="ml-auto"><BrandLogo name="whatsapp" size={18} /></span>
        </div>

        <div class="space-y-2.5 p-4">
          <p
            class="seq ml-auto max-w-[85%] rounded-xl rounded-br-sm bg-brand-100 px-3 py-2 text-[0.85rem] leading-snug text-brand-900"
            style="--d: 200ms"
          >
            {TRY_WHATSAPP.chat.visitor}
          </p>

          <div class="relative">
            <span
              class="seq-typing absolute top-0 left-0 flex gap-1 rounded-xl rounded-bl-sm bg-surface-muted px-3 py-3"
              style="--d: 750ms; --life: 1.2s"
            >
              <span class="size-1.5 rounded-full bg-ink-500"></span>
              <span class="size-1.5 rounded-full bg-ink-500"></span>
              <span class="size-1.5 rounded-full bg-ink-500"></span>
            </span>
            <p
              class="seq max-w-[85%] rounded-xl rounded-bl-sm bg-surface-muted px-3 py-2 text-[0.85rem] leading-snug text-ink-900"
              style="--d: 1900ms"
            >
              {TRY_WHATSAPP.chat.agent}
            </p>
          </div>

          <p
            class="seq ml-auto max-w-[85%] rounded-xl rounded-br-sm bg-brand-100 px-3 py-2 text-[0.85rem] leading-snug text-brand-900"
            style="--d: 3000ms"
          >
            {TRY_WHATSAPP.chat.visitorReply}
          </p>
        </div>
      </div>
    </div>
  </div>
</Section>
