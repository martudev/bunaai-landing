---
/**
 * Los CTAs son siempre `<a>`: no hay ninguno que dispare JS, todos navegan.
 * Usar un <button> acá rompería abrir en pestaña nueva y el menú contextual.
 */
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "ghost";
  size?: "md" | "lg";
  class?: string;
  /** Los links a la app son externos: van con rel por seguridad. */
  external?: boolean;
}

const {
  href,
  variant = "primary",
  size = "md",
  class: className = "",
  external = href.startsWith("http"),
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 rounded-xl font-semibold transition-[transform,background-color,border-color,box-shadow] duration-200 active:translate-y-px whitespace-nowrap";

const sizes = {
  md: "px-5 py-2.5 text-[0.95rem]",
  lg: "px-7 py-3.5 text-base",
};

const variants = {
  primary:
    "bg-brand-500 text-white shadow-[0_1px_2px_rgba(5,10,52,0.08),0_8px_24px_-8px_rgba(47,172,106,0.5)] hover:bg-brand-600 hover:shadow-[0_1px_2px_rgba(5,10,52,0.08),0_12px_28px_-8px_rgba(47,172,106,0.55)]",
  secondary:
    "bg-card text-ink-900 border border-ink-900/12 shadow-[0_1px_2px_rgba(5,10,52,0.06)] hover:border-ink-900/25 hover:bg-ink-900/[0.02]",
  ghost: "text-ink-700 hover:text-ink-900 hover:bg-ink-900/[0.04]",
};
---

<a
  href={href}
  class:list={[base, sizes[size], variants[variant], className]}
  {...external ? { rel: "noopener" } : {}}
>
  <slot />
</a>
