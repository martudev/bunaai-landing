---
/**
 * Migas de pan visibles. El schema equivalente se agrega aparte, desde la
 * página: Google quiere ver las dos cosas y que coincidan.
 */
interface Props {
  items: { name: string; path: string }[];
}

const { items } = Astro.props;
---

<nav aria-label="Migas de pan" class="container-page pt-6">
  <ol class="flex flex-wrap items-center gap-1.5 text-sm text-ink-500">
    {
      items.map((item, index) => {
        const isLast = index === items.length - 1;
        return (
          <li class="flex items-center gap-1.5">
            {isLast ? (
              <span aria-current="page" class="text-ink-700">
                {item.name}
              </span>
            ) : (
              <>
                <a href={item.path} class="hover:text-brand-600 hover:underline">
                  {item.name}
                </a>
                <span aria-hidden="true">/</span>
              </>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
