---
/**
 * Logos oficiales de las plataformas con las que BunaAI se integra.
 *
 * Van inline y no como <img> por dos razones: son parte del contenido visible
 * en el primer viewport de la sección, así que una request extra por logo
 * agregaría latencia justo ahí; y siendo SVG inline escalan sin pedir
 * versiones @2x.
 *
 * Fuentes de cada marca, para poder auditarlas:
 *  - WhatsApp: Simple Icons (CC0), color oficial #25D366.
 *  - Slack: marca de cuatro colores, con sus hex oficiales.
 *  - Tiendanube: ícono de Nimbus, su propio design system. El azul #0059d5 es
 *    su token `--color-light-primary-interactive`.
 *
 * Se usan tal cual los publica cada empresa, sin recolorear: alterar un logo
 * de marca es justo lo que sus guías de uso prohíben.
 */
interface Props {
  name: "whatsapp" | "tiendanube" | "slack";
  size?: number;
  class?: string;
}

const { name, size = 22, class: className = "" } = Astro.props;

// El título del SVG es el nombre accesible. En esta sección cada logo va
// acompañado de un <h3> con el mismo nombre, así que se marca decorativo para
// que un lector de pantalla no lea la marca dos veces seguidas.
// `as const` para que `aria-hidden` se infiera como el literal "true" y no
// como un string cualquiera: los tipos de SVG solo aceptan el literal.
const common = {
  width: size,
  height: size,
  class: className,
  "aria-hidden": "true",
  focusable: "false",
  xmlns: "http://www.w3.org/2000/svg",
} as const;
---

