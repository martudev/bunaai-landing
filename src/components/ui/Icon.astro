---
/**
 * Íconos como SVG inline.
 *
 * Antes esto venía de lucide-react y @tabler/icons-react, lo que obligaba a
 * hidratar React solo para dibujar unas líneas. Un `<path>` inline pesa bytes
 * y no necesita runtime.
 *
 * Los paths son de Lucide (licencia ISC), copiados para no arrastrar la
 * dependencia entera por quince íconos.
 */
interface Props {
  name: keyof typeof PATHS;
  size?: number;
  class?: string;
  /** Solo `true` si el ícono transmite información que el texto no da. */
  label?: string;
}

const PATHS = {
  check: ["M20 6 9 17l-5-5"],
  "arrow-right": ["M5 12h14", "m12 5 7 7-7 7"],
  x: ["M18 6 6 18", "m6 6 12 12"],
  menu: ["M4 6h16", "M4 12h16", "M4 18h16"],
  zap: [
    "M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z",
  ],
  "git-branch": ["M6 3v12", "M18 6a3 3 0 1 0 0-.001Z", "M6 21a3 3 0 1 0 0-.001Z", "M15 6a9 9 0 0 0-9 9"],
  server: [
    "M5 2h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z",
    "M5 14h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2z",
    "M6 6h.01",
    "M6 18h.01",
  ],
  chart: ["M3 3v16a2 2 0 0 0 2 2h16", "M7 15l4-4 3 3 5-6"],
  flask: ["M9 2v6.5L4.2 17A2 2 0 0 0 6 20h12a2 2 0 0 0 1.8-3L15 8.5V2", "M8 2h8", "M7.5 14h9"],
  bell: ["M10.3 21a1.9 1.9 0 0 0 3.4 0", "M4 17h16l-1.6-2.3A3 3 0 0 1 18 13V9a6 6 0 1 0-12 0v4a3 3 0 0 1-.4 1.7z"],
  shield: ["M20 13c0 5-3.5 7.5-7.7 9a1 1 0 0 1-.7 0C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.2-2.7a1.2 1.2 0 0 1 1.5 0C14.5 3.8 17 5 19 5a1 1 0 0 1 1 1z", "m9 12 2 2 4-4"],
  message: ["M7.9 20A9 9 0 1 0 4 16.1L2 22z"],
  sparkles: [
    "M9.9 2.5 12 8l5.5 2.1L12 12.2 9.9 17.7 7.8 12.2 2.3 10.1 7.8 8z",
    "M18 2v4",
    "M20 4h-4",
  ],
  clock: ["M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z", "M12 6v6l4 2"],
  store: [
    "M4 10v10a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V10",
    "m2 9 2-6h16l2 6a3 3 0 0 1-5 2 3 3 0 0 1-5 0 3 3 0 0 1-5 0 3 3 0 0 1-5-2z",
  ],
  plug: ["M12 22v-5", "M9 8V2", "M15 8V2", "M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8z"],
  users: [
    "M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2",
    "M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z",
    "M22 21v-2a4 4 0 0 0-3-3.9",
    "M16 3.1a4 4 0 0 1 0 7.8",
  ],
  slack: [
    "M13 2a2 2 0 0 0-2 2v6a2 2 0 1 0 4 0V4a2 2 0 0 0-2-2z",
    "M19 8a2 2 0 1 0 0 4h1a2 2 0 1 0 0-4z",
    "M11 20a2 2 0 0 0 2-2v-6a2 2 0 1 0-4 0v6a2 2 0 0 0 2 2z",
    "M5 16a2 2 0 1 0 0-4H4a2 2 0 1 0 0 4z",
  ],
} as const;

const { name, size = 20, class: className = "", label } = Astro.props;
const paths = PATHS[name];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
>
  {label && <title>{label}</title>}
  {paths.map((d) => <path d={d} />)}
</svg>
