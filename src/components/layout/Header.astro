---
import { NAV } from "../../data/content";
import { CTA, SITE } from "../../data/site";
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";

// Marca el link de la sección actual. Solo aplica a rutas propias: los anclas
// de la home no se resaltan porque no sabemos en qué parte está el scroll sin
// mandar JS, y no vale la pena el costo.
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header
  class="sticky top-0 z-50 border-b border-ink-900/8 bg-white/85 backdrop-blur-md"
>
  <nav class="container-page flex h-16 items-center gap-6" aria-label="Principal">
    <a
      href="/"
      class="flex shrink-0 items-center gap-2 font-display text-lg font-bold tracking-tight"
      aria-label={`${SITE.name} — Inicio`}
    >
      <img src="/favicon.svg" alt="" width="28" height="28" fetchpriority="high" />
      <span>{SITE.name}</span>
    </a>

    <ul class="ml-2 hidden items-center gap-1 xl:flex">
      {
        NAV.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={path === item.href ? "page" : undefined}
              class:list={[
                "rounded-lg px-3 py-2 text-[0.94rem] font-medium whitespace-nowrap transition-colors",
                path === item.href
                  ? "text-ink-900"
                  : "text-ink-700 hover:bg-ink-900/[0.04] hover:text-ink-900",
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="ml-auto hidden items-center gap-2 xl:flex">
      <Button href={CTA.login.href} variant="ghost">{CTA.login.label}</Button>
      <Button href={CTA.primary.href}>{CTA.primary.label}</Button>
    </div>

    <button
      type="button"
      id="nav-toggle"
      class="ml-auto -mr-2 rounded-lg p-2 text-ink-900 xl:hidden"
      aria-expanded="false"
      aria-controls="nav-mobile"
      aria-label="Abrir menú"
    >
      <Icon name="menu" size={24} />
    </button>
  </nav>

  <div
    id="nav-mobile"
    hidden
    class="border-t border-ink-900/8 bg-white xl:hidden"
  >
    <ul class="container-page flex flex-col gap-1 py-4">
      {
        NAV.map((item) => (
          <li>
            <a
              href={item.href}
              class="block rounded-lg px-3 py-2.5 font-medium text-ink-700 hover:bg-ink-900/[0.04] hover:text-ink-900"
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="mt-3 flex flex-col gap-2">
        <Button href={CTA.primary.href} size="lg">{CTA.primary.label}</Button>
        <Button href={CTA.login.href} variant="secondary" size="lg">
          {CTA.login.label}
        </Button>
      </li>
    </ul>
  </div>
</header>

<script>
  // Único JS del sitio, y existe solo por el menú mobile. Se usa el atributo
  // `hidden` en vez de una clase para que el menú cerrado no sea navegable con
  // teclado ni lo lean los lectores de pantalla.
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("nav-mobile");

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    toggle.setAttribute("aria-label", open ? "Abrir menú" : "Cerrar menú");
    menu?.toggleAttribute("hidden", open);
  });

  // Al tocar un ancla de la misma página no hay navegación, así que el menú
  // quedaría abierto tapando la sección a la que el usuario acaba de saltar.
  menu?.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("a")) {
      toggle?.setAttribute("aria-expanded", "false");
      toggle?.setAttribute("aria-label", "Abrir menú");
      menu.setAttribute("hidden", "");
    }
  });
</script>
