---
/**
 * Plantilla de las páginas legales (/terminos, /privacidad): migas, título,
 * fecha de actualización, bloque del titular y el texto con estilos de lectura.
 *
 * El contenido llega por <slot /> como HTML plano (h2, p, ul) y se estiliza
 * desde acá, para que las páginas no repitan clases en cada párrafo.
 */
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../ui/Breadcrumbs.astro";
import { SITE } from "../../data/site";
import { breadcrumbSchema } from "../../data/schema";

interface Props {
  title: string;
  heading: string;
  description: string;
  path: string;
  /** Fecha visible de la última actualización, ej. "12 de noviembre de 2026". */
  updated: string;
}

const { title, heading, description, path, updated } = Astro.props;

const crumbs = [
  { name: "Inicio", path: "/" },
  { name: heading, path },
];
---

<Layout title={title} description={description} schema={[breadcrumbSchema(crumbs)]}>
  <Breadcrumbs items={crumbs} />

  <article class="container-page pt-10 pb-24">
    <div class="mx-auto max-w-3xl">
      <h1 class="text-[2.2rem] leading-[1.1] sm:text-[2.7rem]">{heading}</h1>
      <p class="mt-4 text-[0.95rem] text-ink-500">Última actualización: {updated}</p>

      <div
        class="mt-8 rounded-2xl border border-ink-900/10 bg-card p-6 text-[0.95rem] leading-relaxed text-ink-700"
      >
        <p class="font-semibold text-ink-900">Responsable del servicio</p>
        <p class="mt-2">
          {SITE.name} es un servicio prestado por <strong class="text-ink-900">{SITE.legal.name}</strong>,
          CUIT {SITE.legal.cuit}, con domicilio en {SITE.legal.address}.
        </p>
        <p class="mt-1">
          Contacto:{" "}
          <a href={`mailto:${SITE.email}`} class="font-medium text-brand-600 hover:underline">
            {SITE.email}
          </a>
        </p>
      </div>

      <div class="legal mt-10">
        <slot />
      </div>
    </div>
  </article>
</Layout>

<style>
  .legal {
    color: var(--color-ink-700);
    font-size: 1rem;
    line-height: 1.75;
  }
  .legal :global(h2) {
    margin-top: 2.75rem;
    font-size: 1.4rem;
    line-height: 1.3;
    color: var(--color-ink-900);
    scroll-margin-top: 6rem;
  }
  .legal :global(h3) {
    margin-top: 1.75rem;
    font-size: 1.1rem;
    color: var(--color-ink-900);
  }
  .legal :global(p),
  .legal :global(ul),
  .legal :global(ol) {
    margin-top: 1rem;
  }
  .legal :global(ul) {
    list-style: disc;
    padding-left: 1.4rem;
  }
  .legal :global(ol) {
    list-style: decimal;
    padding-left: 1.4rem;
  }
  .legal :global(li + li) {
    margin-top: 0.4rem;
  }
  .legal :global(strong) {
    color: var(--color-ink-900);
    font-weight: 600;
  }
  .legal :global(a) {
    color: var(--color-brand-600);
    font-weight: 500;
  }
  .legal :global(a:hover) {
    text-decoration: underline;
  }
</style>
