---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";
import Pricing from "../components/sections/Pricing.astro";
import PlanComparison from "../components/sections/PlanComparison.astro";
import Faq from "../components/sections/Faq.astro";
import FinalCta from "../components/sections/FinalCta.astro";
import Section from "../components/ui/Section.astro";
import Icon from "../components/ui/Icon.astro";
import { PLANS, CURRENCY, PRICING_FAQS, formatPrice } from "../data/pricing";
import { breadcrumbSchema, faqSchema, softwareSchema } from "../data/schema";

const prices = PLANS.map((plan) => plan.price);

const crumbs = [
  { name: "Inicio", path: "/" },
  { name: "Precios", path: "/precios" },
];

const schema = [
  breadcrumbSchema(crumbs),
  softwareSchema({
    lowPrice: Math.min(...prices),
    highPrice: Math.max(...prices),
    currency: CURRENCY,
    offerCount: prices.length,
  }),
  faqSchema(PRICING_FAQS),
];

const incluido = [
  "Infraestructura dedicada: servidores y base de datos exclusivos para tu cuenta",
  "Historial de cambios y vuelta atrás en un click",
  "Actualizaciones del producto",
  "Monitoreo y alertas",
  "Automatizaciones ilimitadas",
  "Recuperación de carritos abandonados",
  "Métricas a medida",
  "IA al costo exacto, sin margen, con el límite de gasto que elijas",
];
---

<Layout
  title={`Precios de BunaAI | Planes desde ${formatPrice(Math.min(...prices))} al mes`}
  description={`Planes de BunaAI desde ${formatPrice(Math.min(...prices))} al mes, con infraestructura, historial de cambios e integraciones incluidos. Pagás en pesos con Mercado Pago, sin setup ni permanencia.`}
  schema={schema}
>
  <Breadcrumbs items={crumbs} />

  <Section class="pt-10! pb-4!">
    <div class="mx-auto max-w-3xl text-center">
      <h1 class="text-[2.2rem] leading-[1.1] sm:text-[2.7rem]">
        Precios simples, sin sorpresas a fin de mes
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-ink-700 md:text-xl">
        El plan incluye la infraestructura. La IA se paga aparte, por lo que
        uses y al costo exacto del proveedor, sin margen. Podés cambiar de plan
        o darte de baja cuando quieras.
      </p>
    </div>
  </Section>

  {/* Sin título propio: el h1 de arriba ya encabeza esta sección. */}
  <Pricing title="" subtitle="" tone="default" cardAs="h2" />

  <PlanComparison />

  {/*
    Los tonos alternan (blanco / gris) para que cada sección se lea separada:
    la comparativa es gris, así que esta va en blanco y las FAQ vuelven a gris.
  */}
  <Section tone="default">
    <div class="mx-auto max-w-3xl">
      <h2 class="text-2xl md:text-3xl">Incluido en todos los planes</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          incluido.map((item) => (
            <li class="flex items-start gap-3 text-[0.98rem] leading-relaxed text-ink-900">
              <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-brand-500 text-white">
                <Icon name="check" size={12} />
              </span>
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Faq
    faqs={PRICING_FAQS}
    title="Preguntas sobre precios"
    tone="muted"
  />

  <FinalCta
    title="Miralo funcionando con tus casos"
    subtitle="En una demo de media hora armamos una automatización tuya en vivo. Si te sirve, te creamos la cuenta y activás el plan con Mercado Pago."
  />
</Layout>
